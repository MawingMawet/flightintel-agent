# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# Absolute path to the upstream AirflowOSky products database (read-only).
FLIGHT_DB_PATH=C:/OM_Source/AirflowOSky/data/processed/products.db

# Google AI Studio key for the Gemini free tier (needed from plan step 3).
GEMINI_API_KEY=

# Root of the local AirflowOSky checkout; the phase 2 corpus builder reads
# committed markdown from it (dev-time only, not needed to run the agent).
UPSTREAM_REPO_PATH=C:/OM_Source/AirflowOSky

# Local pgvector store (WSL2 Ubuntu, phase 2 plan Q7). Port 5433 because a
# native Windows Postgres already holds 5432 on this machine. The setup
# script scripts/setup_pgvector.sh generates and appends the real DSN.
PG_DSN=postgresql://flightintel:CHANGE_ME@localhost:5433/flightintel

# Langfuse tracing (phase 3 plan Q1/Q2), optional: leave empty and the agent
# runs untraced, exactly as before. Keys from the Langfuse project settings;
# same hygiene as GEMINI_API_KEY (never committed, never logged).
# REGION MATTERS: an account created on the US cloud needs
# https://us.cloud.langfuse.com here; the EU host 401s valid US keys
# (hit for real, 2026-08-12).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# BigQuery vector backend (phase 4 plan Q2), optional: the fully qualified
# table id. When set it wins over PG_DSN; leave empty to keep the local
# pgvector store. The cloud service sets this instead of PG_DSN.
#BQ_VECTOR_TABLE=flightintel-505316.flightintel_rag.doc_chunks

# LOCAL BigQuery auth only (plan Q2d): path to the gcloud ADC file inside
# WSL, reachable over the \\wsl$ share. Created once by running
# `gcloud auth application-default login` inside WSL. Never set in the
# cloud, where the runtime service account is the ambient identity.
#BQ_CREDENTIALS=//wsl$/Ubuntu-22.04/home/YOUR_WSL_USER/.config/gcloud/application_default_credentials.json
